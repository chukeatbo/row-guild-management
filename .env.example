DATABASE_URL=postgres://row:row@localhost:5433/row
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:5173

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# bot (apps/bot): เว็บที่ bot เปิดแคปรูป (ไม่ตั้ง = BETTER_AUTH_URL), และ path ของ Chromium/Edge
# ถ้าไม่ตั้ง CHROMIUM_PATH ให้รัน `pnpm --filter bot exec playwright-core install chromium` ก่อน
# WEB_URL=http://localhost:5173
# CHROMIUM_PATH=
# DISCORD_GATEWAY=off   # ปิดการซิงก์ชื่อ (ถ้ายังไม่เปิด Server Members Intent)

# Omise (ยังไม่ได้ใช้ — ดู docs/billing.md): secret key อยู่ฝั่งเซิร์ฟเวอร์เท่านั้น
# OMISE_PUBLIC_KEY=
# OMISE_SECRET_KEY=
# URL webhook ใน Omise dashboard: https://<โดเมนเว็บ>/api/webhooks/omise?token=<OMISE_WEBHOOK_TOKEN>
# OMISE_WEBHOOK_TOKEN=
# landing page (ฝั่งเซิร์ฟเวอร์) ใช้ Bearer นี้เรียก POST /api/orders และ GET /api/orders/:id — สุ่มยาว >= 16 ตัวอักษร
# LANDING_API_KEY=

# ใช้ป้องกัน route /render/* (signed token)
RENDER_SECRET=change-me
